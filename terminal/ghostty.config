font-family = MesloLGMDZ Nerd Font
font-style = Bold
font-size = 12
cursor-style = bar
window-show-tab-bar = always

background = #000000
foreground = #dddddd
cursor-color = #dddddd
cursor-text = #f81ce5

palette = 0=#333333
palette = 1=#ff4444
palette = 2=#33ff00
palette = 3=#feff00
palette = 4=#0066ff
palette = 5=#cc00ff
palette = 6=#00ffff
palette = 7=#d0d0d0
palette = 8=#808080
palette = 9=#fe0100
palette = 10=#33ff00
palette = 11=#feff00
palette = 12=#0066ff
palette = 13=#cc00ff
palette = 14=#00ffff
palette = 15=#ffffff

keybind = shift+enter=text:\x1b\r

# Alt = in-app keys (Meta is reserved for the window manager)
keybind = alt+n=new_tab
keybind = alt+h=previous_tab
keybind = alt+l=next_tab
keybind = alt+w=close_tab:this
